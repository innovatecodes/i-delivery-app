# =============================================================================
# iDelivery - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores para o seu ambiente
# NUNCA versione o .env no controle de versão
#
# Uso:
#   Desenvolvimento: docker compose up -d
#   Produção:        cp .env.example .env.prod && docker compose --env-file .env.prod up -d
# =============================================================================

# -- PostgreSQL --
POSTGRES_DB=i_delivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# DB_PORT: Expõe a porta do PostgreSQL externamente
#   Dev:  "5432" (acessível a partir do host)
#   Prod: ""     (vazio = porta não exposta, apenas interna)
DB_PORT=5432

# -- Docker --
# DOCKER_RESTART_POLICY: Política de reinicialização do container
#   Dev:  "unless-stopped" (reinicia a menos que parado manualmente)
#   Prod: "always"         (sempre reinicia, mesmo após crash)
DOCKER_RESTART_POLICY=unless-stopped

# -- ASP.NET Core --
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# -- String de Conexão (Formato ASP.NET Core: __ = JSON aninhado) --
ConnectionStrings__DefaultConnection=Host=postgres;Database=i_delivery;Username=postgres;Password=CHANGE_ME_IN_PRODUCTION

# -- Autenticação JWT --
JwtOptions__Secret=CHANGE_ME_MIN_32_CHARS_RANDOM_KEY_HERE
JwtOptions__Issuer=i-delivery
JwtOptions__Audience=i-delivery-clients
JwtOptions__AccessTokenExpirationMinutes=30
JwtOptions__RefreshTokenExpirationDays=7

# -- Configurações do Cliente --
ClientSettings__BaseUrl=http://localhost

# -- E-mail (SMTP) --
EmailOptions__EnableEmailSending=false
EmailOptions__SmtpHost=smtp.example.com
EmailOptions__SmtpPort=587
EmailOptions__SmtpUser=smtp@example.com
EmailOptions__SmtpPassword=CHANGE_ME
EmailOptions__UseSsl=true
EmailOptions__FromName=iDelivery
EmailOptions__FromEmail=noreply@example.com

# -- Limites de Memória (Docker) --
# Configure via Docker Desktop > Configurações > Recursos > Avançado
# Ou use a flag --memory do docker run se rodar fora do compose
# Não suportado via docker-compose.yml sem o modo Swarm